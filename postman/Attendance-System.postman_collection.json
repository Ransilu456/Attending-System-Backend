    "event": [
      {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('API did not return a server error', function () {",
            "  pm.expect(pm.response.code).to.be.below(500);",
            "});",
            "if (pm.info.requestName === 'Health') {",
            "  pm.test('Health endpoint reports an operational API', function () {",
            "    pm.expect(pm.response.code).to.eql(200);",
            "    pm.expect(pm.response.json().status).to.eql('ok');",
            "  });",
            "}",
            "if (pm.info.requestName === 'Fetch CSRF token') {",
            "  pm.test('CSRF endpoint returns a token and session ID', function () {",
            "    pm.expect(pm.response.code).to.eql(200);",
            "    pm.expect(pm.response.json().csrfToken).to.be.a('string').and.not.empty;",
            "    pm.expect(pm.response.json().sessionId).to.be.a('string').and.not.empty;",
            "  });",
            "}",
            "if (pm.info.requestName === 'Fetch CSRF token' && pm.response.code === 200) {",
            "  const payload = pm.response.json();",
            "  pm.collectionVariables.set('csrfToken', payload.csrfToken);",
            "  pm.collectionVariables.set('sessionId', payload.sessionId);",
            "  pm.environment.set('csrfToken', payload.csrfToken);",
            "  pm.environment.set('sessionId', payload.sessionId);",
            "}",
            "if (pm.info.requestName === 'Admin login' && pm.response.code === 200) {",
            "  pm.collectionVariables.set('adminToken', pm.response.json().token);",
            "  pm.environment.set('adminToken', pm.response.json().token);",
            "}",
            "if (pm.info.requestName === 'Student legacy login' && pm.response.code === 200) {",
            "  pm.collectionVariables.set('studentToken', pm.response.json().token);",
            "  pm.environment.set('studentToken', pm.response.json().token);",
            "}",
            "if (pm.response.headers.get('Content-Type')?.includes('application/json')) {",
            "  pm.test('JSON response is parseable', function () {",
            "    pm.expect(function () { pm.response.json(); }).not.to.throw();",
            "  });",
            "}"
          ]
        }
      }
    ],
